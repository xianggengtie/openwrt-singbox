{
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "listen_port": 7890,
      "tag": "mixed-in",
      "type": "mixed"
    },
    {
      "listen": "0.0.0.0",
      "listen_port": 7891,
      "tag": "tproxy-in",
      "type": "tproxy"
    },
    {
      "auto_route": true,
      "inet4_address": "172.19.0.1/30",
      "interface_name": "tun0",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "info"
  },
  "route": {
    "rules": [
      {
        "action": "sniff",
        "inbound": [
          "mixed-in",
          "tproxy-in",
          "tun-in"
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      }
    ]
  }
}
